---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
---

<Layout title="Contacto">
  <Navigation />

  <main class="pt-24 pb-12">
    <section class="max-w-3xl mx-auto px-6 py-16">
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-display text-[#2D2A26] mb-4">Contacto</h1>
        <p class="text-lg text-[#6B6560]">¿Te gustaría conocer más sobre la obra de Juan Carlos Pinto?</p>
      </div>

      <div class="grid md:grid-cols-2 gap-12">
        <!-- Formulario -->
        <div class="bg-white rounded-lg shadow-lg p-8 hover:shadow-xl transition-shadow duration-300">
          <h2 class="text-xl font-display text-[#2D2A26] mb-6">Envía un mensaje</h2>
          
          <form class="space-y-5">
            <div>
              <label for="name" class="block text-sm font-body font-medium text-[#2D2A26] mb-2">Nombre</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 border border-[#E8E6E3] rounded-lg focus:border-[#A67B5B] transition-colors bg-[#FAFAF8]"
              />
            </div>
            
            <div>
              <label for="email" class="block text-sm font-body font-medium text-[#2D2A26] mb-2">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 border border-[#E8E6E3] rounded-lg focus:border-[#A67B5B] transition-colors bg-[#FAFAF8]"
              />
            </div>
            
            <div>
              <label for="message" class="block text-sm font-body font-medium text-[#2D2A26] mb-2">Mensaje</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                class="w-full px-4 py-3 border border-[#E8E6E3] rounded-lg focus:border-[#A67B5B] transition-colors bg-[#FAFAF8] resize-none"
              ></textarea>
            </div>
            
            <button
              type="submit"
              class="w-full px-6 py-3 bg-[#A67B5B] text-white font-body font-medium rounded-lg hover:bg-[#8B6914] hover:-translate-y-1 transition-all duration-300 shadow-lg hover:shadow-xl"
            >
              Enviar Mensaje
            </button>
          </form>
        </div>

        <!-- Información -->
        <div class="space-y-8">
          <div class="bg-white rounded-lg shadow-lg p-8 hover:shadow-xl transition-shadow duration-300">
            <h2 class="text-xl font-display text-[#2D2A26] mb-4">Información</h2>
            <div class="space-y-4 text-[#6B6560]">
              <p>
                <strong class="text-[#2D2A26]">Juan Carlos Pinto</strong><br/>
                El Arte en sus Manos
              </p>
              <p>
                Artista argentino (1906-1993)<br/>
                Pintor, dibujante y poeta
              </p>
            </div>
          </div>

          <div class="bg-[#F5F3EF] rounded-lg p-8">
            <h3 class="text-lg font-display text-[#2D2A26] mb-4">Horario de atención</h3>
            <p class="text-[#6B6560] text-sm">
              Para consultas sobre obras, exposiciones o información relacionada con el legado artístico de Juan Carlos Pinto, por favor complete el formulario o escríbanos a nuestro correo.
            </p>
          </div>

          <a
            href="https://wa.me/5491155555555?text=Hola,%20me%20gustar%C3%ADa%20consultar%20sobre%20las%20obras%20de%20Juan%20Carlos%20Pinto"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-3 bg-[#25D366] hover:bg-[#20BD5A] text-white font-body font-medium py-4 px-6 rounded-lg transition-all duration-300 shadow-lg hover:shadow-xl hover:-translate-y-1"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.08 6.974 3.088a9.9 9.9 0 013.483 7.608c.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <span>Contactanos por WhatsApp</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <ScrollToTop />
  <Footer />
</Layout>