---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import { poems } from '../data/poems';
---

<Layout title="Poesías">
  <Navigation />

  <main class="pt-24 pb-12">
    <section class="max-w-3xl mx-auto px-6 py-16">
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-display text-[#2D2A26] mb-4">Poesías</h1>
        <p class="text-lg text-[#6B6560]">Veta casi privada donde conjugó la dulzura, la sutileza y el gracil humor</p>
      </div>

      <div class="space-y-16">
        {poems.map((poem, index) => (
          <article class="bg-white rounded-lg shadow-lg p-8 md:p-12 hover:shadow-xl transition-shadow duration-300">
            <h2 class="text-2xl font-display text-[#A67B5B] mb-8 text-center">{poem.title}</h2>
            <div class="whitespace-pre-line text-[#2D2A26] leading-loose text-lg font-body">
              {poem.content}
            </div>
            <div class="mt-8 pt-6 border-t border-[#E8E6E3] text-center">
              <span class="text-[#A67B5B] font-medium">Juan Carlos Pinto</span>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-16 text-center text-[#6B6560] italic">
        <p>Una veta casi privada fue la de la poesía donde conjugó la dulzura, la sutileza y el grácil humor que caracterizaron su vida.</p>
      </div>
    </section>
  </main>

  <ScrollToTop />
  <Footer />
</Layout>